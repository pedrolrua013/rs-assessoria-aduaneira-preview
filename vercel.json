{
  "buildCommand": "OUT=public python3 _tools/build_pages.py",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-5SX6h1Kk37Wpob5UHOpJwq3oY8XlA1rtpItSbYnjdro=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://formsubmit.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servico/importacao",
      "destination": "/despacho-de-importacao/",
      "permanent": true
    },
    {
      "source": "/servico/exportacao",
      "destination": "/despacho-de-exportacao/",
      "permanent": true
    },
    {
      "source": "/servico/drawback",
      "destination": "/drawback/",
      "permanent": true
    },
    {
      "source": "/servico/logistica",
      "destination": "/logistica-internacional/",
      "permanent": true
    },
    {
      "source": "/servico/brokeragem",
      "destination": "/brokeragem-de-embarques/",
      "permanent": true
    },
    {
      "source": "/fale-conosco",
      "destination": "/#contato",
      "permanent": true
    },
    {
      "source": "/rs-assessoria-aduaneira",
      "destination": "/#sobre",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/#servicos",
      "permanent": true
    },
    {
      "source": "/clientes",
      "destination": "/#agronegocio",
      "permanent": true
    }
  ]
}